# ------------------------------------------------------------------
# Syn - environment configuration template
#
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file. The values shown here are safe
# development defaults and contain no secrets.
#
# Every variable here is optional: the application has built-in
# defaults for each of them. Prefix is SYN_.
# ------------------------------------------------------------------

# Application identity
SYN_APP_NAME=Syn
SYN_ENVIRONMENT=development   # development | testing | production
SYN_HOST=127.0.0.1
SYN_PORT=8001
SYN_LOG_LEVEL=INFO

# Database (SQLite for M0; SQLAlchemy + Alembic already wired)
SYN_DATABASE_URL=sqlite:///./data/syn.db

# Backend configuration (M1: real connectivity to a private llama.cpp server)
SYN_BACKEND_TYPE=llama_cpp
SYN_BACKEND_BASE_URL=http://127.0.0.1:8080
SYN_BACKEND_TIMEOUT_SECONDS=120.0
SYN_BACKEND_CONNECT_TIMEOUT_SECONDS=10.0
SYN_BACKEND_HEALTH_TIMEOUT_SECONDS=5.0

# Admin / management plane (M3)
# Separate bootstrap secret used to protect /admin/* endpoints. If unset,
# the admin plane returns 401. In development you may set this to any
# non-empty value; in production it should be a high-entropy secret.
# This is NOT a replacement for a full admin auth system (M7).
SYN_ADMIN_SECRET=

# Admission control (M4)
SYN_MAX_ACTIVE_REQUESTS=1
SYN_MAX_QUEUE_SIZE=8
SYN_QUEUE_TIMEOUT_SECONDS=30.0

# Usage / quotas (M6)
SYN_DEFAULT_REQUESTS_PER_MINUTE=0
SYN_DEFAULT_REQUESTS_PER_DAY=0
SYN_DEFAULT_TOKENS_PER_DAY=0

# Request hardening (M8)
# Max body bytes; 413 if exceeded. Applies to POST /v1/chat/completions, etc.
SYN_MAX_REQUEST_BODY_BYTES=1048576
# CORS allowed origins (comma-separated, restrictive by default). Empty = no CORS.
# Example: SYN_CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
# Wildcard "*" is rejected.
SYN_CORS_ALLOWED_ORIGINS=