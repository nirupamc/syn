# ------------------------------------------------------------------
# Syn - environment configuration template
#
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file. The values shown here are safe
# development defaults and contain no secrets.
#
# Every variable here is optional: the application has built-in
# defaults for each of them. Prefix is SYN_.
# ------------------------------------------------------------------

# Application identity
SYN_APP_NAME=Syn
SYN_ENVIRONMENT=development   # development | testing | production
SYN_HOST=127.0.0.1
SYN_PORT=8001
SYN_LOG_LEVEL=INFO

# Database (SQLite for M0; SQLAlchemy + Alembic already wired)
SYN_DATABASE_URL=sqlite:///./data/syn.db

# Backend configuration (M1 will implement actual connectivity)
SYN_BACKEND_TYPE=llama_cpp
SYN_BACKEND_BASE_URL=http://127.0.0.1:8080
SYN_BACKEND_TIMEOUT_SECONDS=120.0